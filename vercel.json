{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/rfid-scan", "destination": "/api/rfid-bridge" },
    { "source": "/api/rfid-scan", "destination": "/api/rfid-bridge" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
