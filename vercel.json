{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/rfid-scan", "destination": "/api/rfid-bridge" },
    { "source": "/api/rfid-scan", "destination": "/api/rfid-bridge" },
    { "source": "/((?!api/|assets/|images/).*)", "destination": "/index.html" }
  ]
}
