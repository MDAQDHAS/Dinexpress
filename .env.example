# ==============================================================================
# DineExpress Environment Variables Template
# Copy this file to .env.local for local development.
# Configure these variables in the Vercel Dashboard under Project Settings > Environment Variables.
# NOTE: Never commit sensitive service-role keys or production passwords.
# ==============================================================================

# Supabase Project URL (Public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for browser / client exposure)
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Optional: Dedicated RFID Bridge URL (defaults to /api/rfid-scan on same domain)
VITE_RFID_BRIDGE_URL=/api/rfid-scan
